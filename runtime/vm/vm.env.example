# Copy to protected /etc/backstage/vm.env only after commissioning. No secrets here.
# All four image values must be reviewed immutable repository@sha256 references.
BACKSTAGE_POSTGRES_IMAGE=REPLACE_WITH_POSTGRES_16_DIGEST
BACKSTAGE_IMAGE=REPLACE_WITH_BACKSTAGE_ACR_DIGEST
BACKSTAGE_OAUTH_IMAGE=REPLACE_WITH_OAUTH2_PROXY_DIGEST
BACKSTAGE_CADDY_IMAGE=REPLACE_WITH_CADDY_DIGEST
BACKSTAGE_DOMAIN=REPLACE_WITH_REVIEWED_DNS_NAME
BACKSTAGE_TENANT_ID=REPLACE_WITH_TENANT_UUID
BACKSTAGE_ENTRA_CLIENT_ID=REPLACE_WITH_BACKSTAGE_APP_CLIENT_UUID
BACKSTAGE_INGRESS_CLIENT_ID=REPLACE_WITH_INGRESS_APP_CLIENT_UUID
BACKSTAGE_ENGINEER_GROUP_ID=REPLACE_WITH_ENGINEERING_GROUP_UUID
BACKSTAGE_CATALOG_URL=REPLACE_WITH_REVIEWED_CATALOG_URL
BACKSTAGE_ENGINEER_ROSTER_FILE=/etc/backstage/engineers.yaml
BACKSTAGE_ENGINEER_USER_REFS=REPLACE_WITH_APPROVED_USER_ENTITY_REFS
BACKSTAGE_GITHUB_APP_ID=REPLACE_WITH_SCOPED_APP_ID
BACKSTAGE_GITHUB_APP_CLIENT_ID=REPLACE_WITH_SCOPED_APP_CLIENT_ID
BACKSTAGE_SECRET_DIR=/etc/backstage/secrets
BACKSTAGE_API_PROOF_ENABLED=false
BACKSTAGE_WEB_PROOF_ENABLED=false
BACKSTAGE_SCANNER_PROOF_ENABLED=false
BACKSTAGE_TEMPLATES_ENABLED=false
# When enabling templates, add the separate writer App/installation/repository IDs,
# approved BACKSTAGE_TEMPLATE_MAINTAINERS refs and its restricted private-key file.
